<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1F1F23"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Back Arrow -->
<ImageView
android:id="@+id/iv_back"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:layout_gravity="start"
android:contentDescription="@string/back_arrow"
android:src="@drawable/baseline_arrow_back_24" /> <!-- Use your back arrow drawable -->

    <!-- Title -->
<TextView
android:id="@+id/tv_add_comment"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:layout_gravity="center"
android:layout_marginTop="8dp"
android:text="Add Comment"
android:textColor="@color/white"
android:textSize="22sp"
android:textStyle="bold" />

    <!-- Comment Input Field -->
<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginTop="16dp"
android:background="@drawable/comment_input_background"
android:orientation="horizontal"
android:padding="8dp">

<ImageView
    android:id="@+id/iv_comment_icon"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center_vertical"
    android:src="@drawable/baseline_add_comment_24" /> <!-- Use your comment icon drawable -->

<EditText
    android:id="@+id/et_comment"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_weight="1"
    android:hint="Comment"
    android:inputType="text"
    android:textColorHint="#A6A6A6"
    android:textColor="@color/white" />
</LinearLayout>

    <!-- Submit Button -->
<Button
android:id="@+id/btn_submit"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginTop="16dp"
android:backgroundTint="@color/purple"
android:text="@string/submit"
android:textColor="@android:color/white" />
    </LinearLayout>
